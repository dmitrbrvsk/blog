Добавлен custom-паттерн ASCII-only в @typescript-eslint/naming-convention,
чтобы ловить кириллицу и прочий Unicode в именах переменных, функций,
типов и остальных идентификаторов (closes #33, часть 1).
---
 .changeset/ascii-identifiers-naming.md        |  5 +
 .../eslint/rules/typescript.ts                | 39 ++++++--
 .../rules/naming-convention-ascii.test.ts     | 91 +++++++++++++++++++
 3 files changed, 129 insertions(+), 6 deletions(-)
 create mode 100644 .changeset/ascii-identifiers-naming.md
 create mode 100644 packages/arui-presets-lint/test/rules/naming-convention-ascii.test.ts

diff --git a/.changeset/ascii-identifiers-naming.md b/.changeset/ascii-identifiers-naming.md
new file mode 100644
index 0000000..016a998
--- /dev/null
+++ b/.changeset/ascii-identifiers-naming.md
@@ -0,0 +1,5 @@
+---
+'arui-presets-lint': minor
+---
+
+Запрет non-ASCII символов (в т.ч. кириллицы) в идентификаторах через `@typescript-eslint/naming-convention`
diff --git a/packages/arui-presets-lint/eslint/rules/typescript.ts b/packages/arui-presets-lint/eslint/rules/typescript.ts
index fbaf76d..6274bf9 100644
--- a/packages/arui-presets-lint/eslint/rules/typescript.ts
+++ b/packages/arui-presets-lint/eslint/rules/typescript.ts
@@ -14,6 +14,36 @@ const bestPracticesRules = bestPracticesConfig.rules as Record<string, Linter.Ru
 const importsRules = importsConfig.rules as Record<string, Linter.RuleEntry>;
 const variablesRules = variablesConfig.rules as Record<string, Linter.RuleEntry>;
 
+/** Идентификатор должен состоять только из ASCII (без кириллицы и прочего Unicode). */
+export const ASCII_ONLY_PATTERN = {
+    regex: String.raw`^[\x00-\x7F]+$`,
+    match: true,
+} as const;
+
+/** Опции naming-convention с запретом non-ASCII (см. issue #33). */
+export const namingConventionOptions = [
+    {
+        selector: 'default',
+        format: null,
+        custom: ASCII_ONLY_PATTERN,
+    },
+    {
+        selector: 'variable',
+        format: ['camelCase', 'PascalCase', 'UPPER_CASE'],
+        custom: ASCII_ONLY_PATTERN,
+    },
+    {
+        selector: 'function',
+        format: ['camelCase', 'PascalCase'],
+        custom: ASCII_ONLY_PATTERN,
+    },
+    {
+        selector: 'typeLike',
+        format: ['PascalCase'],
+        custom: ASCII_ONLY_PATTERN,
+    },
+] as const;
+
 export const typescriptConfig: Linter.Config = {
     name: 'arui-presets-lint/typescript',
     files: [TYPESCRIPT_SCRIPTS_SCOPE],
@@ -78,12 +108,9 @@ export const typescriptConfig: Linter.Config = {
 
         // Определяет правила именования
         // https://typescript-eslint.io/rules/naming-convention
-        '@typescript-eslint/naming-convention': [
-            'error',
-            { selector: 'variable', format: ['camelCase', 'PascalCase', 'UPPER_CASE'] },
-            { selector: 'function', format: ['camelCase', 'PascalCase'] },
-            { selector: 'typeLike', format: ['PascalCase'] },
-        ],
+        // custom ASCII-only: format camelCase/PascalCase допускает Unicode (кириллицу и т.п.)
+        // https://github.com/core-ds/arui-presets-lint/issues/33
+        '@typescript-eslint/naming-convention': ['error', ...namingConventionOptions],
 
         // Запрещает вызов require()
         // https://typescript-eslint.io/rules/no-require-imports
diff --git a/packages/arui-presets-lint/test/rules/naming-convention-ascii.test.ts b/packages/arui-presets-lint/test/rules/naming-convention-ascii.test.ts
