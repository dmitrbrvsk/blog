ARG NODE_VERSION=22.22.0
ARG ALPINE_VERSION=3.23
ARG NODE_BASE_IMAGE=node

# Пакетный slim: без компиляции nginx.
# Alpine 3.23 даёт nginx 1.28.x и nginx-mod-http-brotli.
#
# Не замена текущего slim, пока на проекте нужен brotli_auto_dictionary
# из heymdall-legal/ngx-brotli-cdt — пакетный модуль этого флага не имеет.
#
# В nginx.conf приложения / базы нужно добавить:
#   load_module modules/ngx_http_brotli_filter_module.so;
#   load_module modules/ngx_http_brotli_static_module.so;

FROM ${NODE_BASE_IMAGE}:${NODE_VERSION}-alpine${ALPINE_VERSION}

COPY nginx.conf /etc/nginx/nginx.conf

RUN addgroup -g 101 -S nginx \
    && adduser --uid 100 -D -S -h /var/cache/nginx -s /sbin/nologin -G nginx nginx \
    && apk add --no-cache \
        nginx \
        nginx-mod-http-brotli \
        gettext \
        tzdata \
    && mkdir -p /var/log/nginx /var/cache/nginx /etc/nginx/conf.d \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

EXPOSE 80 443
STOPSIGNAL SIGTERM
