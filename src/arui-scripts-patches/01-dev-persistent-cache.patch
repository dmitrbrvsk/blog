+import { getDevPersistentCache, getRspackCache } from '../get-dev-persistent-cache';
+
+describe('getRspackCache', () => {
+    it('enables persistent cache only in dev', () => {
+        expect(getRspackCache('prod', 'client-dev')).toBe(false);
+
+        const cache = getRspackCache('dev', 'client-dev');
+
+        expect(cache).toMatchObject({
+            type: 'persistent',
+            name: 'client-dev',
+        });
+    });
+});
+
+describe('getDevPersistentCache', () => {
+    it('invalidates cache on arui-scripts version and project config files', () => {
+        const cache = getDevPersistentCache('server-dev');
+
+        expect(cache.version).toEqual(expect.any(String));
+        expect(cache.buildDependencies).toEqual(
+            expect.arrayContaining([expect.stringMatching(/package\.json$/)]),
+        );
+        expect(cache.snapshot?.immutablePaths).toEqual([/[\\/]\.yarn[\\/]cache[\\/]/]);
+    });
+});
diff --git a/packages/arui-scripts/src/configs/util/get-dev-persistent-cache.ts b/packages/arui-scripts/src/configs/util/get-dev-persistent-cache.ts
new file mode 100644
index 0000000..b45b9aa
--- /dev/null
+++ b/packages/arui-scripts/src/configs/util/get-dev-persistent-cache.ts
@@ -0,0 +1,32 @@
+import { type Configuration } from '@rspack/core';
+
+import { getWebpackCacheDependencies } from './get-webpack-cache-dependencies';
+
+// eslint-disable-next-line @typescript-eslint/no-var-requires, global-require
+const aruiScriptsPackage = require('../../../package.json') as { version: string };
+
+type PersistentCache = Extract<NonNullable<Configuration['cache']>, { type: 'persistent' }>;
+
+/**
+ * Persistent cache только для dev. Prod намеренно остаётся без кеша:
+ * CI-сборка должна быть воспроизводимой и не зависеть от диска агента.
+ */
+export function getDevPersistentCache(name: string): PersistentCache {
+    return {
+        type: 'persistent',
+        name,
+        version: aruiScriptsPackage.version,
+        buildDependencies: getWebpackCacheDependencies(),
+        snapshot: {
+            immutablePaths: [/[\\/]\.yarn[\\/]cache[\\/]/],
+        },
+    };
+}
+
+export function getRspackCache(mode: 'dev' | 'prod', name: string): Configuration['cache'] {
+    if (mode !== 'dev') {
+        return false;
+    }
+
+    return getDevPersistentCache(name);
+}
