+/**
+ * Файлы, от которых зависит конфигурация сборки.
+ * Нужны Rspack persistent cache: при их изменении кеш инвалидируется.
+ */
+export function getWebpackCacheDependencies(): string[] {
+    return [
+        ...configs.overridesPath,
+        getConfigFilePath(configs.cwd),
+        getPresetsConfigPath(configs, configs.cwd),
+        configs.tsconfig,
+        // eslint-disable-next-line global-require, @typescript-eslint/no-var-requires
+        require.resolve('../../../package.json'),
+    ].filter((filePath): filePath is string => Boolean(filePath));
 }
